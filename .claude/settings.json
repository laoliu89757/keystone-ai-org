{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(npm run lint)",
      "Bash(npm test:*)",
      "Bash(vendor/bin/phpunit:*)",
      "Bash(python scripts/check_org.py)",
      "Bash(python scripts/gate_drill.py)",
      "Bash(python scripts/gate_drill.py:*)",
      "Bash(python .paseo/apply_profiles.py --dry-run)",
      "Bash(python .paseo/apply_profiles.py --prune-legacy --dry-run)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "mcp__paseo",
      "mcp__paseo__list_profiles",
      "mcp__paseo__list_agents",
      "mcp__paseo__list_workspaces",
      "mcp__paseo__get_agent_status",
      "mcp__paseo__get_agent_activity",
      "Bash(sed:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(echo:*)",
      "Bash(bash -n:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(python -V)",
      "Bash(python --version)",
      "Bash(printf:*)",
      "Bash(mkdir:*)",
      "Bash(git -C:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree:*)",
      "Bash(pytest --version)",
      "Bash(which:*)",
      "Bash(tree:*)",
      "Bash(file:*)",
      "Bash(python -c:*)",
      "Bash(python3 -c:*)",
      "Bash(python -m json.tool:*)",
      "Bash(python -m compileall:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Edit(./.github/**)",
      "Edit(./.claude/**)",
      "Edit(./.paseo/**)",
      "Edit(./CODEOWNERS)",
      "Edit(./AGENTS.md)",
      "Edit(./evals/baseline/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(ssh:*)",
      "Bash(kubectl:*)",
      "Bash(mysql:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/guard_bash.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/guard_paths.sh"
          }
        ]
      }
    ]
  }
}
