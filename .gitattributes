# 统一换行：仓库内一律 LF，避免 Windows 检出后钩子脚本带 \r 跑不起来
* text=auto eol=lf

# 脚本必须 LF（CRLF 会让 bash 报 $'\r': command not found）
*.sh           text eol=lf
*.py           text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.json         text eol=lf
CODEOWNERS     text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Windows 专用脚本保留 CRLF
*.cmd          text eol=crlf
*.bat          text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.pdf binary
