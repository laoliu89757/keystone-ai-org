# ---- OS / 编辑器 ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Node（产品仓库接管后） ----
node_modules/
dist/
unpackage/
*.log

# ---- 密钥与本地配置：永不入库 ----
.env
.env.*
secrets/
*.pem
*.key

# ---- 本地备份 / 临时 ----
*.bak
*.bak-*
*.orig
*.rej
*.tmp
tmp/
/board-local/

# ---- Paseo 运行时产物（配置本体在 ~/.paseo，不入库；只留 config.patch.json） ----
.paseo/config.json
.paseo/*.log

# ---- 模型/依赖缓存 ----
.cache/
